---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileContactBar from '../../components/MobileContactBar.astro';
import { business } from '../../data/business';

const canonical = `${business.domain}/xeraco/`;
const title = 'Cerrajero 24h en Xeraco y Playa de Xeraco';
const description = 'Cerrajero 24h en Xeraco pueblo y Playa de Xeraco. Viviendas, apartamentos y comunidades. Llegada habitual de 30–35 minutos.';
const faqs = [
  { question: '¿Atendéis tanto Xeraco como Playa de Xeraco?', answer: 'Sí. Esta página cubre en un único servicio Xeraco pueblo y Playa de Xeraco, con atención directa en ambas zonas.' },
  { question: '¿Cuánto tardáis habitualmente en llegar?', answer: 'La llegada habitual es de 30–35 minutos. El tráfico, el punto concreto y la disponibilidad del momento pueden modificar esa referencia.' },
  { question: '¿Atendéis apartamentos y segundas residencias?', answer: 'Sí. Atendemos apartamentos, segundas residencias y viviendas de uso estacional, además de vivienda habitual y comunidades.' },
  { question: '¿Puedo enviar una foto de la cerradura?', answer: 'Sí. Puedes enviarla por WhatsApp con una breve explicación y tu ubicación en Xeraco o Playa de Xeraco para que valoremos mejor el aviso.' },
  { question: '¿Trabajáis las 24 horas?', answer: 'Sí. El servicio de urgencias está disponible 24 horas para problemas que no pueden esperar, tanto en el pueblo como en la playa.' },
];
const jsonLd = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': ['Locksmith', 'LocalBusiness'], '@id': `${business.domain}/#business`, name: business.name, url: canonical, telephone: business.phone.e164, description, address: { '@type': 'PostalAddress', streetAddress: business.address.streetAddress, postalCode: business.address.postalCode, addressLocality: business.address.addressLocality, addressRegion: business.address.addressRegion, addressCountry: business.address.addressCountry }, areaServed: [{ '@type': 'City', name: 'Xeraco' }, { '@type': 'Place', name: 'Playa de Xeraco' }], openingHoursSpecification: { '@type': 'OpeningHoursSpecification', ...business.openingHoursSpecification }, sameAs: [business.googleMaps.url, business.social.facebook, business.social.instagram] },
  { '@type': 'WebSite', '@id': `${business.domain}/#website`, url: `${business.domain}/`, name: business.name, inLanguage: 'es-ES', publisher: { '@id': `${business.domain}/#business` } },
  { '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
] }, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [{ '@type': 'ListItem', position: 1, name: 'Inicio', item: `${business.domain}/` }, { '@type': 'ListItem', position: 2, name: 'Xeraco', item: canonical }] }];
---

<BaseLayout title={title} description={description} canonical={canonical} robots="index,follow" themeColor="#101820" openGraph={{ type: 'website', locale: 'es_ES', title, description, url: canonical }} twitter={{ card: 'summary' }}>
  <div class="topbar"><strong>Cerrajero de urgencias 24h</strong> · Xeraco y Playa de Xeraco</div>
  <Header brandHref="/" subtitle="Xeraco · Playa de Xeraco" />
  <main id="inicio">
    <section class="hero"><div class="wrap hero-grid"><div><span class="eyebrow"><span class="dot"></span> Pueblo y playa · urgencias 24h</span><h1>Cerrajero 24h en Xeraco y Playa de Xeraco</h1><p>Una sola atención para dos realidades: vivienda habitual en Xeraco y apartamentos o segundas residencias en Playa de Xeraco. Si el acceso falla, habla directamente con Cerrajería del Puerto.</p><div class="actions"><a class="btn btn-primary" href={`tel:${business.phone.e164}`}>☎ Llamar ahora · {business.phone.display}</a><a class="btn btn-secondary" href={business.whatsapp.heroUrl} rel="noopener" target="_blank">Enviar foto por WhatsApp</a></div><div class="proofline"><span>✓ <b>Servicio 24h</b></span><span>✓ <b>30–35 min habitualmente</b></span><span>✓ Xeraco pueblo</span><span>✓ <b>Playa de Xeraco</b></span></div></div><aside aria-label="Contacto urgente" class="urgency-card"><div class="label">Indica si estás en pueblo o playa</div><h2>Ubicación y foto agilizan la valoración.</h2><p>Envíanos el punto exacto y una imagen de la cerradura. Así sabemos dónde está el aviso y qué tipo de acceso tenemos delante.</p><div class="phonebox"><small>Teléfono 24h</small><a href={`tel:${business.phone.e164}`}>{business.phone.display}</a></div><a class="btn btn-primary" href={`tel:${business.phone.e164}`} style="width:100%">Llamar ahora</a><p class="mini">Cobertura conjunta de Xeraco y Playa de Xeraco.</p></aside></div></section>

    <section class="section"><div class="wrap"><div class="section-head"><span class="kicker">Dos zonas, necesidades diferentes</span><h2 class="section-title">La urgencia no siempre ocurre en una vivienda ocupada todo el año.</h2><p>En la playa puede aparecer al volver a un apartamento tras meses cerrado; en el pueblo, al salir de casa o abrir un negocio. Por eso preguntamos primero dónde estás y cómo se usa la vivienda.</p></div><div class="steps"><article class="step"><div class="num">1</div><h3>Confirma la zona</h3><p>Dinos si el aviso está en Xeraco pueblo o en Playa de Xeraco.</p></article><article class="step"><div class="num">2</div><h3>Explica el acceso</h3><p>Vivienda habitual, apartamento, portal comunitario o pequeño negocio.</p></article><article class="step"><div class="num">3</div><h3>Envía una imagen</h3><p>Una foto permite observar el bombín, el escudo y el estado visible del cierre.</p></article><article class="step"><div class="num">4</div><h3>Recibe atención directa</h3><p>Te explicamos la intervención y nos desplazamos sin centralitas.</p></article></div></div></section>

    <section class="section white" id="servicios"><div class="wrap"><div class="section-head"><span class="kicker">Apertura, sustitución y urgencias</span><h2 class="section-title">Recuperar la entrada hoy y dejar un cierre fiable después.</h2><p>El objetivo cambia según el caso: abrir una puerta bloqueada, sustituir un bombín deteriorado o asegurar una vivienda tras perder las llaves.</p></div><div class="services"><article class="service"><h3>Puertas que no abren</h3><p>Apertura en viviendas, apartamentos y locales, valorando antes la opción adecuada para el mecanismo instalado.</p></article><article class="service"><h3>Cambio de bombín o cerradura</h3><p>Para averías, llaves extraviadas, cambios de ocupación o cierres que han quedado obsoletos por el uso.</p></article><article class="service"><h3>Respuesta 24h</h3><p>Atención urgente en cualquier horario cuando no puedes entrar, cerrar o dejar la propiedad segura.</p></article></div></div></section>

    <section class="section" id="zona"><div class="wrap trust"><div class="trust-panel"><h3>Por qué llamar a una cerrajería local</h3><div class="checks"><div class="check"><svg fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24"><path d="M20 6L9 17l-5-5"></path></svg><span><strong>Atención directa desde el primer momento.</strong> Quien recibe tu llamada entiende el problema y se ocupa del aviso.</span></div><div class="check"><svg fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24"><path d="M20 6L9 17l-5-5"></path></svg><span><strong>Ubicamos pueblo y playa.</strong> Saber en cuál de las dos zonas estás permite organizar el desplazamiento sin confusiones.</span></div><div class="check"><svg fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24"><path d="M20 6L9 17l-5-5"></path></svg><span><strong>Más de dos décadas en el oficio.</strong> La experiencia permite distinguir qué necesita cada cierre sin tratar todos los casos igual.</span></div><div class="check"><svg fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24"><path d="M20 6L9 17l-5-5"></path></svg><span><strong>Urgencias durante las 24 horas.</strong> Puedes llamar si una vivienda o un local no puede quedar accesible o seguro.</span></div><div class="check"><svg fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24"><path d="M20 6L9 17l-5-5"></path></svg><span><strong>Intervención y precio explicados.</strong> Antes de empezar sabrás qué proponemos hacer y cuánto cuesta.</span></div><div class="check"><svg fill="none" stroke="currentColor" stroke-width="2" viewbox="0 0 24 24"><path d="M20 6L9 17l-5-5"></path></svg><span><strong>Una referencia realista.</strong> La llegada habitual a Xeraco es de 30–35 minutos, sujeta al tráfico y la disponibilidad.</span></div></div></div><div class="local"><span class="kicker">Xeraco pueblo y playa</span><h3>Vivienda habitual y estacional, en una sola cobertura.</h3><p>En Xeraco pueblo atendemos viviendas habituales, comunidades y pequeños negocios. En Playa de Xeraco, el servicio incluye apartamentos, segundas residencias y accesos compartidos que pueden necesitar atención al regresar después de un tiempo sin uso.</p><div class="gandia-arrival" style="margin-top:20px;padding:18px 20px;background:rgba(255,255,255,.72);border:1px solid rgba(16,24,32,.08);border-radius:16px"><div style="font-size:.78rem;text-transform:uppercase;letter-spacing:.11em;font-weight:850;color:#8a6513">Para ambas zonas</div><strong style="display:block;font-size:1.25rem;margin-top:4px">Llegada habitual: 30–35 minutos</strong><p style="margin:6px 0 0;color:var(--muted);font-size:.9rem">Referencia sujeta al tráfico, el punto concreto y la disponibilidad.</p></div><div class="areas"><span>Xeraco pueblo</span><span>Playa de Xeraco</span><span>Polígono Industrial de Xeraco</span></div></div></div></section>

    <section class="section white" id="faq"><div class="wrap faq"><div class="section-head"><span class="kicker">Preguntas frecuentes</span><h2 class="section-title">Cobertura conjunta, respuestas claras.</h2></div>{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
    <section class="cta"><div class="wrap cta-row"><div><h2>¿El aviso está en Xeraco o en la playa?</h2><p>Llama y dinos la zona exacta para atenderte.</p></div><a class="btn" href={`tel:${business.phone.e164}`}>☎ {business.phone.display}</a></div></section>
  </main>
  <Footer /><MobileContactBar />
  {jsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
</BaseLayout>
