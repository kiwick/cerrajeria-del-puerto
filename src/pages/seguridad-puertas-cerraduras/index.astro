---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import MobileContactBar from '../../components/MobileContactBar.astro';
import { business } from '../../data/business';

const canonical = `${business.domain}/seguridad-puertas-cerraduras/`;
const title = 'Seguridad en puertas y cerraduras | Cerrajería Gandía';
const description = 'Compara bombines, escudos, cerraduras multipunto, cerrojos y cerraduras inteligentes. Guía de seguridad de Cerrajería del Puerto en Gandía y La Safor.';
const whatsappMessage = 'Hola, quiero mejorar la seguridad de mi puerta. Te envío unas fotos para que puedas ver qué tengo instalado.';
const whatsappUrl = `https://wa.me/${business.phone.e164.replace('+', '')}?text=${encodeURIComponent(whatsappMessage)}`;

const systems = [
  { id: 'estandar', name: 'Bombín / cilindro estándar', short: 'La solución básica que encontramos en muchas puertas.', tags: ['Cilindro', 'Llave'], image: '/images/security/bombin-estandar-puerta-768.webp', srcset: '/images/security/bombin-estandar-puerta-320.webp 320w, /images/security/bombin-estandar-puerta-480.webp 480w, /images/security/bombin-estandar-puerta-768.webp 768w, /images/security/bombin-estandar-puerta-1024.webp 1024w', sizes: '(max-width: 520px) calc(100vw - 26px), (max-width: 700px) calc(100vw - 36px), (max-width: 960px) calc((100vw - 54px) / 2), 368px', alt: 'Bombín o cilindro estándar para puerta', finalImage: true, acts: 'El cilindro donde entra la llave', bumping: 'No es su función', extraction: 'No es su función', drilling: 'No es su función', force: 'No es su función', second: 'No', electronic: 'No', combines: 'Sí' },
  { id: 'seguridad', name: 'Bombín / cilindro de seguridad', short: 'Según el modelo puede incorporar protecciones frente a diferentes técnicas de ataque.', tags: ['Antibumping*', 'Antitaladro*', 'Antiextracción*'], note: '* Según modelo.', image: '/images/security/bombin-seguridad-puerta-768.webp', srcset: '/images/security/bombin-seguridad-puerta-320.webp 320w, /images/security/bombin-seguridad-puerta-480.webp 480w, /images/security/bombin-seguridad-puerta-768.webp 768w, /images/security/bombin-seguridad-puerta-1024.webp 1024w', sizes: '(max-width: 520px) calc(100vw - 26px), (max-width: 700px) calc(100vw - 36px), (max-width: 960px) calc((100vw - 54px) / 2), 368px', alt: 'Bombín de seguridad para puerta con protecciones reforzadas', finalImage: true, acts: 'El cilindro donde entra la llave', bumping: 'Según modelo', extraction: 'Según modelo', drilling: 'Según modelo', force: 'No es su función', second: 'No', electronic: 'No', combines: 'Sí' },
  { id: 'escudo', name: 'Escudo de seguridad', short: 'Protege físicamente el bombín desde el exterior y dificulta el acceso directo al cilindro.', tags: ['Protección exterior', 'Bombín'], image: '/images/security/escudo-seguridad-bombin-768.webp', srcset: '/images/security/escudo-seguridad-bombin-320.webp 320w, /images/security/escudo-seguridad-bombin-480.webp 480w, /images/security/escudo-seguridad-bombin-768.webp 768w, /images/security/escudo-seguridad-bombin-1024.webp 1024w', sizes: '(max-width: 520px) calc(100vw - 26px), (max-width: 700px) calc(100vw - 36px), (max-width: 960px) calc((100vw - 54px) / 2), 368px', alt: 'Escudo de seguridad para proteger el bombín de una puerta', finalImage: true, acts: 'El exterior del cilindro', bumping: 'Aporta protección indirecta', extraction: 'Aporta protección', drilling: 'Según modelo', force: 'No es su función', second: 'No', electronic: 'No', combines: 'Sí' },
  { id: 'multipunto', name: 'Cerradura multipunto', short: 'Distribuye el cierre de la puerta en varios puntos de anclaje.', tags: ['Varios cierres', 'Puerta'], image: '/images/security/cerradura-multipunto-puerta-768.webp', srcset: '/images/security/cerradura-multipunto-puerta-320.webp 320w, /images/security/cerradura-multipunto-puerta-480.webp 480w, /images/security/cerradura-multipunto-puerta-768.webp 768w, /images/security/cerradura-multipunto-puerta-1024.webp 1024w', sizes: '(max-width: 520px) calc(100vw - 26px), (max-width: 700px) calc(100vw - 36px), (max-width: 960px) calc((100vw - 54px) / 2), 368px', alt: 'Mecanismo de cerradura multipunto para puerta', finalImage: true, imageWidth: 768, imageHeight: 1152, acts: 'Varios puntos del canto de la puerta', bumping: 'Depende del cilindro', extraction: 'Depende del cilindro y escudo', drilling: 'Depende del cilindro y escudo', force: 'Aporta protección', second: 'No', electronic: 'No', combines: 'Sí' },
  { id: 'cerrojo', name: 'Cerrojo de seguridad', short: 'Añade un mecanismo de cierre complementario o independiente del cierre principal.', tags: ['Refuerzo', 'Segundo cierre'], image: '/images/security/cerrojo-seguridad-puerta-768.webp', srcset: '/images/security/cerrojo-seguridad-puerta-320.webp 320w, /images/security/cerrojo-seguridad-puerta-480.webp 480w, /images/security/cerrojo-seguridad-puerta-768.webp 768w, /images/security/cerrojo-seguridad-puerta-1024.webp 1024w', sizes: '(max-width: 520px) calc(100vw - 26px), (max-width: 700px) calc(100vw - 36px), (max-width: 960px) calc((100vw - 54px) / 2), 368px', alt: 'Cerrojo de seguridad para puerta', finalImage: true, acts: 'Un cierre adicional en la puerta', bumping: 'Según modelo', extraction: 'Según modelo', drilling: 'Según modelo', force: 'Aporta protección', second: 'Sí', electronic: 'No', combines: 'Sí' },
  { id: 'inteligente', name: 'Cerradura inteligente', short: 'Permite gestionar el acceso mediante funciones electrónicas que dependen del sistema instalado.', tags: ['Acceso digital', 'Control'], image: '/images/security/cerradura-inteligente-puerta-768.webp', srcset: '/images/security/cerradura-inteligente-puerta-320.webp 320w, /images/security/cerradura-inteligente-puerta-480.webp 480w, /images/security/cerradura-inteligente-puerta-768.webp 768w, /images/security/cerradura-inteligente-puerta-1024.webp 1024w', sizes: '(max-width: 520px) calc(100vw - 26px), (max-width: 700px) calc(100vw - 36px), (max-width: 960px) calc((100vw - 54px) / 2), 368px', alt: 'Cerradura inteligente con control electrónico de acceso', finalImage: true, acts: 'La gestión del acceso', bumping: 'Depende del sistema mecánico', extraction: 'Depende del sistema mecánico', drilling: 'Depende del sistema mecánico', force: 'No es su función', second: 'Según instalación', electronic: 'Sí', combines: 'Sí' },
];
const comparisonCriteria = [
  { label: 'Actúa sobre', key: 'acts' },
  { label: 'Bumping / manipulación', key: 'bumping' },
  { label: 'Extracción del cilindro', key: 'extraction' },
  { label: 'Taladrado', key: 'drilling' },
  { label: 'Fuerza sobre la puerta', key: 'force' },
  { label: 'Segundo cierre independiente', key: 'second' },
  { label: 'Acceso electrónico', key: 'electronic' },
  { label: 'Puede combinarse con otros', key: 'combines' },
] as const;

const faqs = [
  { question: '¿Qué diferencia hay entre bombín y cerradura?', answer: 'El bombín o cilindro es la pieza donde se introduce la llave. La cerradura es el mecanismo instalado en la puerta que acciona el cierre. En muchos sistemas se puede sustituir el bombín sin cambiar la cerradura completa.' },
  { question: '¿Qué es más importante, un buen bombín o un escudo de seguridad?', answer: 'Cumplen funciones distintas y pueden complementarse. El bombín gestiona la llave y puede incorporar protecciones según el modelo; el escudo protege físicamente el cilindro desde el exterior.' },
  { question: '¿Qué es el bumping?', answer: 'Es una técnica de manipulación que intenta accionar los elementos internos de determinados cilindros mediante una llave preparada. La resistencia depende del diseño y del modelo del bombín.' },
  { question: '¿Se puede cambiar el bombín sin cambiar la cerradura?', answer: 'En muchas puertas sí, siempre que el cilindro sea sustituible y el nuevo sea compatible con la cerradura, las medidas y la configuración de la puerta.' },
  { question: '¿Qué aporta una cerradura multipunto?', answer: 'Reparte el cierre en varios puntos de anclaje del canto de la puerta. Su resultado depende también de la puerta, el marco, el cilindro, el escudo y la instalación.' },
  { question: '¿Para qué sirve un cerrojo de seguridad?', answer: 'Añade un cierre complementario o independiente del principal. Puede crear una segunda barrera, pero su aportación concreta depende del modelo y de cómo esté instalado.' },
  { question: '¿Una cerradura inteligente es más segura?', answer: 'No necesariamente por el hecho de ser electrónica. Facilita la gestión de accesos, pero la seguridad final depende del sistema completo, su parte mecánica, la instalación y la configuración.' },
  { question: '¿Cómo puedo saber qué cerradura tengo?', answer: 'Puedes enviarnos una foto del exterior de la puerta y otra del canto con la puerta abierta. No hace falta que conozcas el nombre del sistema: las imágenes ayudan a identificar qué hay instalado.' },
];

const jsonLd = [{ '@context': 'https://schema.org', '@graph': [
  { '@type': 'WebPage', '@id': canonical, url: canonical, name: title, description, inLanguage: 'es-ES', isPartOf: { '@id': `${business.domain}/#website` }, about: { '@id': `${business.domain}/#business` } },
  { '@type': 'FAQPage', '@id': `${canonical}#faq`, mainEntity: faqs.map(({ question, answer }) => ({ '@type': 'Question', name: question, acceptedAnswer: { '@type': 'Answer', text: answer } })) },
] }, { '@context': 'https://schema.org', '@type': 'BreadcrumbList', itemListElement: [
  { '@type': 'ListItem', position: 1, name: 'Inicio', item: `${business.domain}/` },
  { '@type': 'ListItem', position: 2, name: 'Seguridad en puertas y cerraduras', item: canonical },
] }];
---

<BaseLayout title={title} description={description} canonical={canonical} robots="index,follow" themeColor="#101820" openGraph={{ type: 'website', locale: 'es_ES', title, description, url: canonical }} twitter={{ card: 'summary', title, description }}>
  <div class="topbar"><strong>Orientación directa sobre seguridad</strong> · Gandía y La Safor</div>
  <Header brandHref="/" subtitle="Gandía · La Safor" navLinks={[{ href: '#sistemas', label: 'Sistemas' }, { href: '#comparador', label: 'Comparador' }, { href: '#diagnostico', label: 'Orientación' }, { href: '#faq', label: 'Preguntas' }]} />
  <main id="inicio">
    <section class="hero security-hero"><div class="wrap hero-grid"><div>
      <span class="eyebrow">GUÍA Y COMPARADOR DE SEGURIDAD</span>
      <h1>¿Qué protege realmente la cerradura de tu casa?</h1>
      <p>Bombín, cerradura y escudo cumplen funciones distintas. Esta guía te ayuda a entenderlas, compararlas y saber qué conviene revisar en tu puerta.</p>
      <div class="actions"><a class="btn btn-primary" href={whatsappUrl} rel="noopener" target="_blank">Enviar fotos por WhatsApp</a><a class="btn btn-secondary" href={`tel:${business.phone.e164}`}>☎ Llamar · {business.phone.display}</a></div>
      <div class="proofline"><span>✓ <b>Gandía y La Safor</b></span><span>✓ Atención directa</span><span>✓ <b>Más de 20 años</b></span></div>
      <p class="mini">Guía preparada por Cerrajería del Puerto para ayudarte a entender y mejorar la seguridad de puertas y cerraduras en viviendas de Gandía y La Safor.</p>
    </div><aside class="urgency-card guide-card"><div class="label">Una puerta es un conjunto</div><h2>La seguridad no depende de una sola pieza.</h2><p>El cilindro recibe la llave, la cerradura acciona el cierre y el escudo protege el cilindro desde fuera. La puerta y el marco también influyen.</p><div class="guide-diagram" aria-label="Relación entre bombín, cerradura y escudo"><span>Escudo</span><span>Bombín</span><span>Cerradura</span></div><p class="mini">Mejorar la seguridad no siempre implica cambiar toda la cerradura.</p></aside></div></section>

    <section class="section" id="sistemas"><div class="wrap"><div class="section-head"><span class="kicker">Las piezas y su función</span><h2 class="section-title">Bombín, cerradura y escudo no son lo mismo</h2><p>Cada elemento actúa en una parte diferente. Entender qué hace —y qué no hace— evita comparar soluciones que en realidad pueden trabajar juntas.</p></div>
      <div class="security-cards">{systems.map((system) => <article class="security-card">
        <div class="placeholder-wrap"><img src={system.image} srcset={system.srcset} sizes={system.sizes} alt={system.alt} width={system.imageWidth ?? (system.finalImage ? 768 : 640)} height={system.imageHeight ?? (system.finalImage ? 512 : 400)} loading="lazy" decoding={system.finalImage ? 'async' : undefined} style={system.finalImage ? 'object-fit:contain;background:#fff' : undefined} />{!system.finalImage && <span>Imagen provisional</span>}</div>
        <div class="security-card-body"><h3>{system.name}</h3><p>{system.short}</p><div class="security-tags">{system.tags.map((tag) => <span>{tag}</span>)}</div>{system.note && <small>{system.note}</small>}
        <label class="compare-control"><input type="checkbox" value={system.id} data-compare /> Añadir a la comparación</label></div>
      </article>)}</div>
    </div></section>

    <section class="section white" id="comparador"><div class="wrap"><div class="section-head"><span class="kicker">Selecciona entre dos y tres</span><h2 class="section-title">Compara qué protege cada sistema</h2><p>La tabla describe funciones generales. “Según modelo” indica que la prestación no puede darse por supuesta sin revisar el producto y la instalación.</p></div>
      <div class="compare-status" aria-live="polite"><strong data-compare-count>Selecciona al menos 2 sistemas.</strong><span data-compare-limit></span></div>
      <div class="compare-output" data-compare-output><div class="table-scroll"><table><caption>Comparación de funciones de seguridad</caption><thead><tr><th scope="col">Criterio</th>{systems.map((system) => <th scope="col" data-system-column={system.id}>{system.name}</th>)}</tr></thead><tbody>{comparisonCriteria.map(({ label, key }) => <tr><th scope="row">{label}</th>{systems.map((system) => <td data-system-column={system.id}>{system[key]}</td>)}</tr>)}</tbody></table></div></div>
      <div class="combination-note"><strong>Estos sistemas no necesariamente compiten entre sí.</strong><p>Actúan sobre elementos distintos y pueden combinarse. Por ejemplo, un bombín de seguridad puede trabajar junto a un escudo que limite el acceso físico al cilindro.</p></div>
      <div class="actions section-actions"><a class="btn btn-dark" href={whatsappUrl} rel="noopener" target="_blank">Enviar fotos para valorar mi puerta</a></div>
    </div></section>

    <section class="section"><div class="wrap prose-grid"><article><span class="kicker">Protecciones</span><h2 class="section-title">Protección frente a técnicas distintas</h2><p>No existe una etiqueta que garantice por sí sola la seguridad del conjunto. El diseño del cilindro, su exposición desde el exterior, la cerradura, la puerta, el marco y la instalación condicionan el resultado.</p><p>Por eso conviene separar la resistencia a la manipulación de la protección física frente a extracción, taladrado o fuerza sobre la puerta.</p></article><article><span class="kicker">Manipulación</span><h2 class="section-title">¿Qué significa antibumping?</h2><p>El bumping es una técnica que trata de accionar determinados cilindros mediante una llave preparada. Un bombín puede incorporar soluciones frente a ella, pero esa prestación depende del modelo concreto.</p><p>“Antibumping” no sustituye a un escudo, no refuerza el marco y no significa que todos los demás ataques queden cubiertos.</p></article></div></section>

    <section class="section white"><div class="wrap"><div class="section-head"><span class="kicker">Decidir por función</span><h2 class="section-title">Cómo mejorar la seguridad sin cambiarlo todo</h2><p>En cerrajería, mejorar una puerta no significa necesariamente sustituir todo el sistema. Según lo que ya tengas instalado, puede tener más sentido revisar el bombín, protegerlo con un escudo o actuar sobre el cierre completo.</p></div><div class="system-details">
      <article><h3>Bombines y cilindros</h3><div class="function-lines"><p><strong>Qué hace:</strong><span>Recibe la llave y permite accionar la cerradura.</span></p><p><strong>Qué no hace:</strong><span>No refuerza por sí solo la puerta ni el marco.</span></p></div><p>Pueden combinarse con escudos y distintos tipos de cerradura. Conviene revisarlos si sobresalen, fallan, se han perdido llaves o se busca una prestación concreta. Sus protecciones dependen del modelo y de una medida e instalación adecuadas.</p></article>
      <article><h3>Escudos de seguridad</h3><div class="function-lines"><p><strong>Qué hace:</strong><span>Cubre y protege físicamente el cilindro desde el exterior.</span></p><p><strong>Qué no hace:</strong><span>No sustituye el mecanismo de cierre.</span></p></div><p>Se combinan habitualmente con bombines y cerraduras. Conviene revisar su fijación, resistencia y cuánto deja expuesto el cilindro. Su aportación depende del diseño y del montaje.</p></article>
      <article><h3>Cerraduras multipunto</h3><div class="function-lines"><p><strong>Qué hace:</strong><span>Distribuye el cierre en varios anclajes.</span></p><p><strong>Qué no hace:</strong><span>No garantiza que cilindro, escudo, puerta o marco sean adecuados.</span></p></div><p>Pueden combinarse con cilindros y escudos compatibles. Conviene revisarlas si los puntos no alinean o el mecanismo trabaja forzado. Su resultado depende del conjunto.</p></article>
      <article><h3>Cerrojos de seguridad</h3><div class="function-lines"><p><strong>Qué hace:</strong><span>Añade un cierre complementario o independiente.</span></p><p><strong>Qué no hace:</strong><span>No corrige automáticamente las debilidades del cierre principal.</span></p></div><p>Pueden convivir con la cerradura existente si la puerta lo permite. Conviene revisarlos cuando se busca una segunda barrera. El modelo, la puerta y la fijación determinan su utilidad.</p></article>
      <article><h3>Cerraduras inteligentes</h3><div class="function-lines"><p><strong>Qué hace:</strong><span>Gestiona accesos mediante funciones electrónicas.</span></p><p><strong>Qué no hace:</strong><span>No es necesariamente más resistente por ser digital.</span></p></div><p>Puede combinar electrónica y mecanismos convencionales. Conviene revisar compatibilidad, alimentación, accesos de respaldo y parte mecánica. Sus prestaciones varían según el sistema instalado.</p></article>
    </div></div></section>

    <section class="section"><div class="wrap"><div class="section-head"><span class="kicker">Ejemplos orientativos</span><h2 class="section-title">Combinaciones habituales según el objetivo</h2><p>Una mejora puede actuar sobre una sola pieza o sobre varias capas de la puerta.</p></div><div class="combination-grid"><article><strong>MEJORAR EL CILINDRO</strong><p>Bombín de seguridad.</p></article><article><strong>PROTEGER EL CILINDRO</strong><p>Bombín de seguridad + escudo.</p></article><article><strong>REFORZAR EL CIERRE</strong><p>Bombín + escudo + cerradura multipunto.</p></article><article><strong>SEGUNDA BARRERA</strong><p>Cierre existente + cerrojo de seguridad.</p></article><article><strong>GESTIONAR ACCESOS</strong><p>Cerradura inteligente.</p></article></div><p class="configuration-note">La configuración adecuada depende de la puerta y de lo que ya esté instalado.</p></div></section>

    <section class="section white"><div class="wrap glossary"><div class="section-head"><span class="kicker">Glosario práctico</span><h2 class="section-title">Entender para decidir mejor</h2></div><details><summary>Bumping</summary><p>Técnica de manipulación aplicable a determinados cilindros. La resistencia depende del diseño y modelo.</p></details><details><summary>Antiextracción</summary><p>Medidas destinadas a dificultar que el cilindro sea extraído. Pueden depender del bombín, el escudo y la instalación.</p></details><details><summary>Antitaladro</summary><p>Elementos que dificultan el ataque mediante taladrado en zonas concretas del mecanismo. Su presencia y alcance dependen del modelo.</p></details><details><summary>Ganzúa y manipulación</summary><p>Técnicas que intentan accionar el cilindro sin su llave original. La resistencia varía según el mecanismo.</p></details><details><summary>Cilindro frente a cerradura</summary><p>El cilindro recibe la llave; la cerradura acciona los elementos que mantienen cerrada la puerta.</p></details><details><summary>Combinar sistemas</summary><p>Un cilindro, un escudo, una cerradura o un cerrojo pueden cubrir funciones diferentes y trabajar juntos si son compatibles.</p></details></div></section>

    <section class="section diagnosis" id="diagnostico"><div class="wrap trust"><div><span class="kicker">Orientación sobre tu puerta</span><h2 class="section-title">Entonces, ¿qué debería poner en mi puerta?</h2><p>No siempre hace falta cambiar todo. Primero se puede revisar el bombín, la protección exterior, la cerradura y el conjunto de puerta y marco.</p><p><strong>No hace falta que sepas qué tienes instalado.</strong> Envíanos dos fotos y desde Cerrajería del Puerto podemos orientarte antes de valorar una intervención en Gandía o La Safor.</p><div class="actions"><a class="btn btn-primary" href={whatsappUrl} rel="noopener" target="_blank">Enviar fotos por WhatsApp</a><a class="btn btn-dark" href={`tel:${business.phone.e164}`}>Llamar al {business.phone.display}</a></div><p class="diagnosis-note">Envíanos las fotos y cuéntanos qué quieres mejorar. Atención directa en Gandía y La Safor.</p></div><aside class="photo-guide"><h3>Dos fotos útiles</h3><ol><li><strong>Exterior:</strong> la zona del bombín y el escudo.</li><li><strong>Canto abierto:</strong> la cerradura y sus puntos de cierre.</li></ol><p>Evita incluir llaves, direcciones o datos personales en la imagen.</p><div class="photo-trust"><strong>Más de 20 años trabajando con puertas y cerraduras</strong><p>Podemos orientarte a partir de unas fotos para saber qué conviene revisar antes de cambiar nada.</p></div></aside></div></section>

    <section class="section urgency-security"><div class="wrap cta-row"><div><span class="kicker">Cerrajero 24h en Gandía y La Safor</span><h2>¿El problema no es la seguridad sino que no puedes entrar?</h2><p>Si las llaves han quedado dentro, la cerradura se ha bloqueado o la llave no gira, se valora primero la técnica de apertura adecuada intentando evitar daños innecesarios cuando el tipo de puerta y cerradura lo permiten.</p></div><div class="urgency-actions"><a class="btn btn-primary" href={`tel:${business.phone.e164}`}>☎ Llamar ahora</a><a class="btn btn-secondary" href={whatsappUrl} rel="noopener" target="_blank">Contactar por WhatsApp</a></div></div></section>

    <section class="section white" id="faq"><div class="wrap guide-authority"><div class="price-promise"><div class="num">✓</div><div><h3>Una guía de Cerrajería del Puerto</h3><p>Más de 20 años trabajando con puertas y cerraduras en Gandía y La Safor. Esta guía está pensada para explicar de forma sencilla qué hace cada sistema y ayudarte a saber qué conviene revisar antes de cambiar nada.</p></div></div></div><div class="wrap faq"><div class="section-head security-faq-head"><span class="kicker">Preguntas frecuentes</span><h2 class="section-title">Dudas sobre seguridad en puertas y cerraduras</h2></div>{faqs.map(({ question, answer }) => <details><summary>{question}</summary><p>{answer}</p></details>)}</div></section>
    <section class="cta"><div class="wrap cta-row"><div><h2>Revisa primero lo que ya tienes.</h2><p>Envíanos dos fotos de la puerta y cuéntanos qué quieres mejorar en Gandía o La Safor.</p></div><a class="btn" href={whatsappUrl} rel="noopener" target="_blank">Enviar fotos por WhatsApp</a></div></section>
  </main>
  <Footer /><MobileContactBar whatsappUrl={whatsappUrl} />
  {jsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)} />)}
  <script>
    const checkboxes = [...document.querySelectorAll('[data-compare]')];
    const output = document.querySelector('[data-compare-output]');
    const count = document.querySelector('[data-compare-count]');
    const limit = document.querySelector('[data-compare-limit]');
    const columns = [...document.querySelectorAll('[data-system-column]')];
    const render = () => {
      const selected = checkboxes.filter((input) => input.checked).map((input) => input.value);
      checkboxes.forEach((input) => { input.disabled = selected.length >= 3 && !input.checked; });
      count.textContent = selected.length < 2 ? `Selecciona al menos 2 sistemas. Has seleccionado ${selected.length}.` : `${selected.length} sistemas seleccionados.`;
      limit.textContent = selected.length === 3 ? ' Máximo alcanzado.' : '';
      output.hidden = selected.length < 2;
      columns.forEach((column) => {
        const visible = selected.includes(column.dataset.systemColumn);
        column.hidden = !visible;
        column.setAttribute('aria-hidden', String(!visible));
      });
    };
    checkboxes.forEach((input) => input.addEventListener('change', render));
    render();
  </script>
</BaseLayout>
