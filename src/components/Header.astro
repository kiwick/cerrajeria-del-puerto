---
import { business } from '../data/business';

interface Props {
  brandHref: string;
  subtitle: string;
  navLinks?: { href: string; label: string }[];
}

const { brandHref, subtitle, navLinks = [
  { href: '#servicios', label: 'Servicios' },
  { href: '#opiniones', label: 'Opiniones' },
  { href: '#zona', label: 'Zona de servicio' },
  { href: '#faq', label: 'Preguntas' },
] } = Astro.props;
---

<header>
  <div class="wrap">
    <nav>
      <a aria-label={business.name} class="brand" href={brandHref}>
        <span aria-hidden="true" class="brandmark">
          <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="8" cy="15" r="4"></circle><path d="M11 12l8-8m-2 2 2 2m-5 1 2 2"></path></svg>
        </span>
        <span>{business.shortName}<small>{subtitle}</small></span>
      </a>
      <div class="navlinks">
        {navLinks.map(({ href, label }) => <><a href={href}>{label}</a>{' '}</>)}
        <a class="call-sm" href={`tel:${business.phone.e164}`}>☎ {business.phone.display}</a>
      </div>
    </nav>
  </div>
</header>
